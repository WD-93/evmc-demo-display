//Algo: intercalate ",\n " mnemonic ": " opcode (TODO in hex)
//Using op_mnems defined earlier:
//writeFile "toCopy.txt" $ intercalate ",\n"
// [" "++mnem++": "++show op | (op,mnem) <- op_mnems]
