data Push15 = {Push15 (UInt 15)};
data Push16 = {Push16 (UInt 16)};
data Push17 = {Push17 (UInt 17)};
data Push18 = {Push18 (UInt 18)};
data Push19 = {Push19 (UInt 19)};
data Push20 = {Push20 (UInt 20)};
data Push21 = {Push21 (UInt 21)};
