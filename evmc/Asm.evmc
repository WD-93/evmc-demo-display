data Push23 = {Push23 (UInt 23)};
data Push24 = {Push24 (UInt 24)};
data Push25 = {Push25 (UInt 25)};
data Push26 = {Push26 (UInt 26)};
data Push27 = {Push27 (UInt 27)};
data Push28 = {Push28 (UInt 28)};
data Push29 = {Push29 (UInt 29)};
data Push30 = {Push30 (UInt 30)};
data Push31 = {Push31 (UInt 31)};
data Push32 = {Push32 (UInt 32)};
//tag n=let s=show n in concat["tag Push",s," = EVM where {Push",s,": PUSH",s,"};\n"]
//writeFile "toCopy.txt" $ concat $ map tag [1..32]
tag Push1 = EVM where {Push1: PUSH1};
tag Push2 = EVM where {Push2: PUSH2};
tag Push3 = EVM where {Push3: PUSH3};
tag Push4 = EVM where {Push4: PUSH4};
tag Push5 = EVM where {Push5: PUSH5};
tag Push6 = EVM where {Push6: PUSH6};
tag Push7 = EVM where {Push7: PUSH7};
tag Push8 = EVM where {Push8: PUSH8};
tag Push9 = EVM where {Push9: PUSH9};
