//Need 33 PUSH* variants, one for each byte length.
//That's because I don't have compile-time evaluation of constexprs; otherwise
//I could have tag Push n = Byte where {Push: op_push0 + knownNat (PN :: PN n)}.
//Autogen to the rescue!
//TODO write an autogen lib.
data Push0 = {Push0};
tag Push0 = EVM where {Push0: PUSH0};
//Algo:
//data Push<n> = {Push<n> (UInt <n>)};
//tag Push<n> = EVM where {Push<n>: PUSH<n>};\n
//In GHCI:
//dat n=let s=show n in concat["data Push",s," = {Push",s," (UInt ",s,")};\n"]
//writeFile "toCopy.txt" $ concat $ map dat [1..32]
data Push1 = {Push1 (UInt 1)};
data Push2 = {Push2 (UInt 2)};
data Push3 = {Push3 (UInt 3)};
data Push4 = {Push4 (UInt 4)};
data Push5 = {Push5 (UInt 5)};
data Push6 = {Push6 (UInt 6)};
data Push7 = {Push7 (UInt 7)};
data Push8 = {Push8 (UInt 8)};
data Push9 = {Push9 (UInt 9)};
data Push10 = {Push10 (UInt 10)};
data Push11 = {Push11 (UInt 11)};
data Push12 = {Push12 (UInt 12)};
data Push13 = {Push13 (UInt 13)};
