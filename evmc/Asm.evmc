//Push2 variants for Ptr and Fun:
PushPtr : Region -> Type -> Type;
data PushPtr r a = {PushPtr (Ptr r a)};
tag PushPtr r a = EVM where {PushPtr: PUSH2};
data PushFun a b = {PushFun (a -> b)};
tag PushFun a b = EVM where {PushFun: PUSH2};